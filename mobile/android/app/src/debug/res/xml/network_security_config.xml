<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives under src/debug, so it is merged into debug builds
  and never into a release build.

  Android has blocked plain HTTP since API 28. A development backend runs on the
  developer's Mac at http://[LAN address]:8082 with no certificate, so a debug build has
  to be allowed to speak cleartext or every request fails before it leaves the phone.

  The LAN address is not listed here because it changes with the network; pinning it would
  mean editing this file on every new Wi-Fi. Release builds keep Android's default, which
  permits HTTPS only.

  Note for editors: XML forbids a double hyphen inside a comment, so command line flags
  are spelled out in prose here rather than written literally.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
