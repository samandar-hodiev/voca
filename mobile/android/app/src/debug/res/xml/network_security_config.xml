<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY. This file lives under src/debug, so it is merged into debug builds
  and never into release: `flutter build apk --release` does not see it.

  Android blocks plain HTTP by default from API 28 onwards. A development backend runs on
  the developer's Mac over http://<LAN IP>:8082 with no certificate, so a debug build has
  to be allowed to speak cleartext or every request fails before it leaves the phone.

  The LAN address changes with the network, so it is not listed here: pinning it would mean
  editing this file on every new Wi-Fi. Release builds keep Android's default, which
  permits HTTPS only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
