# Voca backend configuration — NAMES AND FORMATS ONLY. Never commit real values.
# Copy to .env and fill in. Full reference: docs/architecture/ARCHITECTURE.md section 25.2

APP_ENV=development                 # development | staging | production
PORT=8082
LOG_LEVEL=debug                     # debug | info | warn | error

DATABASE_URL=postgres://voca:voca@localhost:5432/voca?sslmode=disable
DATABASE_MAX_CONNS=20

# 32+ random bytes, base64 encoded
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1440h

# mock locally: no vendor key needed, no cost, deterministic results
SPEECH_PROVIDER=mock                # azure | google | mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TIMEOUT=10s

PAYMENT_PROVIDER=mock               # revenuecat | mock
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=

APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

# --- Email ---
# Ko'p tarmoqlarda 587 va 465 portlari bloklangan, shuning uchun HTTPS orqali
# yuboradigan API birinchi tanlanadi. resend.com da bepul kalit olinadi.
# Brevo: faqat jo'natuvchi manzilni tasdiqlash kifoya, domen shart emas.
# Domen hali yo'q bo'lganda yagona ishlaydigan variant.
BREVO_API_KEY=
BREVO_FROM=                         # Brevo hisobida tasdiqlangan manzil
BREVO_FROM_NAME=Voca

# Resend: har kimga yuborish uchun domen tasdiqlangan bo'lishi kerak.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev   # domen tasdiqlanmaguncha faqat shu manzil
RESEND_FROM_NAME=Voca


# SMTP sozlansa, tasdiqlash kodi haqiqiy pochtaga boradi.
# Gmail uchun: 2FA yoqilgan bo'lishi va App Password olingan bo'lishi kerak
# (myaccount.google.com -> Security -> App passwords). Oddiy parol ishlamaydi.
SMTP_HOST=                          # masalan: smtp.gmail.com
SMTP_PORT=587                       # 587 = STARTTLS, 465 = to'g'ridan-to'g'ri TLS
SMTP_USERNAME=                      # to'liq pochta manzili
SMTP_PASSWORD=                      # App Password, oddiy parol emas
SMTP_FROM=                          # SMTP_USERNAME bilan bir xil bo'lgani ma'qul
SMTP_FROM_NAME=Voca

# SMTP bo'sh bo'lsa va bu to'ldirilsa, xabarlar shu katalogga fayl sifatida yoziladi.
# Faqat development uchun; production'da provider ishga tushmaydi.
EMAIL_OUTBOX_DIR=tmp/mail

# Yuklangan profil rasmlari shu katalogga yoziladi va /media/avatars ostida
# qaytariladi. Keyinroq obyekt xotirasiga o'tkaziladi.
AVATAR_DIR=tmp/avatars

ANALYTICS_PROVIDER=noop             # posthog | firebase | noop
ANALYTICS_API_KEY=
ANALYTICS_HOST=

NOTIFICATION_PROVIDER=noop          # fcm | noop
FCM_SERVICE_ACCOUNT_JSON=

# memory is the MVP default; redis arrives at Stage 2 (ADR-010)
CACHE_DRIVER=memory                 # memory | redis
REDIS_URL=

FREE_DAILY_ASSESSMENT_LIMIT=10
MAX_AUDIO_SIZE_BYTES=2097152
MAX_AUDIO_DURATION_MS=15000

SCORING_VERSION=v1
SCORE_WEIGHT_ACCURACY=0.5
SCORE_WEIGHT_FLUENCY=0.3
SCORE_WEIGHT_COMPLETENESS=0.2

# MVP stores no user audio at all (ARCHITECTURE.md section 12.3)
AUDIO_RETENTION_ENABLED=false

# --- GitHub webhook -> Telegram bildirishnomasi (internal/devhook) ---
# GitHub webhook sozlamasidagi "Secret" maydoni bilan bir xil bo'lishi shart.
# Bo'sh qoldirilsa, har bir webhook so'rovi rad etiladi (fail closed).
GITHUB_WEBHOOK_SECRET=

# @BotFather bergan token. Ikkalasi ham bo'lmasa, bildirishnoma faqat logga yoziladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SENTRY_DSN=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ASSESSMENT_PER_MIN=20
