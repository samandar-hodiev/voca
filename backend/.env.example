# Voca backend configuration — NAMES AND FORMATS ONLY. Never commit real values.
# Copy to .env and fill in. Full reference: docs/architecture/ARCHITECTURE.md section 25.2

APP_ENV=development                 # development | staging | production
PORT=8082
LOG_LEVEL=debug                     # debug | info | warn | error

DATABASE_URL=postgres://voca:voca@localhost:5432/voca?sslmode=disable
DATABASE_MAX_CONNS=20

# 32+ random bytes, base64 encoded
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=1440h

# mock locally: no vendor key needed, no cost, deterministic results
SPEECH_PROVIDER=mock                # azure | google | mock
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
AZURE_SPEECH_TIMEOUT=10s

PAYMENT_PROVIDER=mock               # revenuecat | mock
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_SECRET=

APPLE_BUNDLE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=

ANALYTICS_PROVIDER=noop             # posthog | firebase | noop
ANALYTICS_API_KEY=
ANALYTICS_HOST=

NOTIFICATION_PROVIDER=noop          # fcm | noop
FCM_SERVICE_ACCOUNT_JSON=

# memory is the MVP default; redis arrives at Stage 2 (ADR-010)
CACHE_DRIVER=memory                 # memory | redis
REDIS_URL=

FREE_DAILY_ASSESSMENT_LIMIT=10
MAX_AUDIO_SIZE_BYTES=2097152
MAX_AUDIO_DURATION_MS=15000

SCORING_VERSION=v1
SCORE_WEIGHT_ACCURACY=0.5
SCORE_WEIGHT_FLUENCY=0.3
SCORE_WEIGHT_COMPLETENESS=0.2

# MVP stores no user audio at all (ARCHITECTURE.md section 12.3)
AUDIO_RETENTION_ENABLED=false

# --- GitHub webhook -> Telegram bildirishnomasi (internal/devhook) ---
# GitHub webhook sozlamasidagi "Secret" maydoni bilan bir xil bo'lishi shart.
# Bo'sh qoldirilsa, har bir webhook so'rovi rad etiladi (fail closed).
GITHUB_WEBHOOK_SECRET=

# @BotFather bergan token. Ikkalasi ham bo'lmasa, bildirishnoma faqat logga yoziladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SENTRY_DSN=
CORS_ALLOWED_ORIGINS=
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_ASSESSMENT_PER_MIN=20
